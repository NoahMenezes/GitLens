{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "bun: watch",
      "command": "bun",
      "args": ["run", "watch"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "type": "shell",
      "label": "bun: compile",
      "command": "bun",
      "args": ["run", "compile"],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$tsc"
    }
  ]
}
