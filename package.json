{
  "name": "codebeam",
  "displayName": "CodeBeam",
  "description": "Beam your code straight to AI — no copy-paste, no tab-switching.",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "license": "MIT",
  "keywords": [
    "ai",
    "chatgpt",
    "claude",
    "copilot",
    "clipboard",
    "productivity",
    "context"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:codebeam.sendSelection",
    "onCommand:codebeam.chooseTarget"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codebeam.sendSelection",
        "title": "CodeBeam: Send Selection to AI"
      },
      {
        "command": "codebeam.chooseTarget",
        "title": "CodeBeam: Choose Send Target"
      }
    ],
    "keybindings": [
      {
        "command": "codebeam.sendSelection",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codebeam.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CodeBeam",
      "properties": {
        "codebeam.defaultTarget": {
          "type": "string",
          "enum": ["auto", "clipboard", "terminal"],
          "default": "auto",
          "description": "Where CodeBeam sends code. 'auto' tries the terminal first and falls back to the clipboard; 'clipboard' always copies; 'terminal' always requires a terminal and shows an error if none exists."
        },
        "codebeam.rememberTerminalChoice": {
          "type": "boolean",
          "default": true,
          "description": "Remember the terminal picked in the quickpick for the rest of the session (stored in workspaceState) so you are not prompted every time."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun ./esbuild.js",
    "watch": "bun ./esbuild.js --watch",
    "package": "bun ./esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "echo \"No tests yet (V1)\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.3.3"
  }
}
